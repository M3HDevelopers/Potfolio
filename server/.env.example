# Copy this file to .env and fill in your values.

# Port the API listens on
PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/portfolio

# Secret used to sign JWT tokens. Use a long random string.
JWT_SECRET=change_this_to_a_long_random_string

# Admin login. The single admin account created by `npm run seed`.
ADMIN_EMAIL=muzammil.ahmed.dev@gmail.com
ADMIN_PASSWORD=admin123

# Allowed origin for CORS (your deployed frontend URL, or * while developing)
CORS_ORIGIN=*

# SMTP for sending real OTP emails.
# Leave SMTP_HOST empty and the OTP code is printed to the server console instead.
# For Gmail use an App Password. For Brevo/SendGrid use their SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Muzammil Ahmed <no-reply@example.com>
